# 元宝搜索 API Key（腾讯云 wsa 控制台创建，Bearer 鉴权）
TENCENTCLOUD_WSA_APIKEY=

# 大模型，任意 OpenAI 兼容接口。默认按混元填写；换 DeepSeek 时：
#   LLM_BASE_URL=https://api.deepseek.com  LLM_MODEL=deepseek-chat
# Kimi 开放平台（按量付费，推荐做最终结果）：LLM_BASE_URL=https://api.moonshot.cn/v1  LLM_MODEL=kimi-k2.6  LLM_THINKING=off
# Kimi Code 会员 key（sk-kimi- 开头）：LLM_BASE_URL=https://api.kimi.com/coding/v1  LLM_MODEL=kimi-for-coding
LLM_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
LLM_API_KEY=
LLM_MODEL=hunyuan-turbos-latest
# 推理模型关闭思考（kimi-k2.6 / kimi-k3 等），非推理模型留空即可
LLM_THINKING=

# 备选鉴权：腾讯云账号密钥（AKID 开头）+ SecretKey，走 TC3 签名。配了上面的 sk- key 就不需要这两项
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
