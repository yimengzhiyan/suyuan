# 不用 Docker 时的 systemd 服务。放到 /etc/systemd/system/suyuan.service
[Unit]
Description=Suyuan rumor verification web app
After=network.target

[Service]
User=www-data
WorkingDirectory=/opt/suyuan
Environment=SUYUAN_PUBLIC=1
ExecStart=/opt/suyuan/.venv/bin/uvicorn server:app --host 127.0.0.1 --port 8601 --proxy-headers
Restart=always

[Install]
WantedBy=multi-user.target
